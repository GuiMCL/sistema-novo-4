# =============================================================================
# MyAutoAtend — credenciais únicas do stack
# Copie para .env e edite:  cp .env.example .env
# =============================================================================
#
# LOGIN e SENHA são usados em TODOS os portais:
#   • Painel admin    http://localhost:8000/admin  → LOGIN / SENHA
#   • Evolution API   http://localhost:9090        → apikey = SENHA
#
# Use uma senha forte. Trocar depois é tranquilo: edite aqui e rode
# `docker compose up -d` de novo.
#
# O resto é configurado DEPOIS, pelo painel admin:
#   chave de IA (OpenAI etc.), telefone do dono e instruções do agente.
# =============================================================================

LOGIN=admin@admin.com
SENHA=12345678
